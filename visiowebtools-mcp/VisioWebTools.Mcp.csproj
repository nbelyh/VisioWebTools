<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>visio-mcp</ToolCommandName>
    <PackageId>UnmanagedVisio.VisioWebTools.Mcp</PackageId>
    <Description>MCP server exposing VisioWebTools (VSDX manipulation) to AI assistants.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.4.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\vsdxtools\VsdxTools.csproj" />
  </ItemGroup>
</Project>
